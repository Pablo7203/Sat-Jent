# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_APP_ENV=production

# Server-only. Public catalogue routes are enabled by default in this commerce
# project. Set false to temporarily take the customer storefront offline.
PUBLIC_WEBSITE_ENABLED=true

# Server-only. Required for checkout order requests and trusted Auth administration.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Paystack secret keys must never use the NEXT_PUBLIC_ prefix.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Server-only access-change notifications (https://resend.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL=SAT-J Ent <notifications@example.com>

# Optional local E2E identity setup. Use synthetic credentials only.
E2E_ACTIVE_PASSWORD=
E2E_INACTIVE_PASSWORD=

# Optional controlled opening-stock import operator. Never use a production
# employee password in local or CI configuration.
OPENING_STOCK_OPERATOR_EMAIL=
OPENING_STOCK_OPERATOR_PASSWORD=
